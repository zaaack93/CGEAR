        "subheading": "",
        "title": "<h1>Tactical Extraction Platform</h1>",
        "heading_highlight_type": "circle",
        "highlight_color": "#d43747",
        "highlight_text_color": "",
        "heading_size": 100,
        "content": "<p>The CGear Tactical Extraction Platform was designed for personnel rescue and deployment in extreme and dangerous environments.<br/><br/>Originally designed to be used for deployment by helicopters, the Tactical Extraction Platform is now in service in marine rescue and on oil and gas platforms for transference of personnel and cargo.</p>",
        "text_alignment": "left",

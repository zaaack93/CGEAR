    "accordion-section-3": {
      "type": "section-accordions",
      "blocks": {
        "text_hNKhHc": {
          "type": "text",
          "settings": {
            "title": "What is the multimat warranty?",
            "text": "<p>Multimat has a 12 month warranty from the date of purchase. This is a manufacturer’s warranty eg faulty sewing or material. Faulty products should be returned to the place of purchase together with a copy of the original receipt.</p>"
          }
        },
        "accordion_block_3_0": {
          "type": "text",
          "settings": {
            "title": "Do you conduct quality control?",
            "text": "<p>All our products are subject to quality control.<br/><br/>Our warranty provides a guarantee against manufacturer defects.<br/><br/>The guarantee covers any manufacturing, design, or material defect. Please notify us within 2 months of noticing any defects.<br/><br/>It does not cover blows, improper use, or other issues that are not attributable to a manufacturer defects.</p>"
          }
        },
        "accordion_block_3_1": {
          "type": "text",
          "settings": {
            "title": "Do you offer extended warranty?",
            "text": "<p>An extended warranty can be added to your products for an additional cost.</p><p>Please get in touch for more information.</p>"
          }
        },
        "text_z69QnX": {
          "type": "text",
          "settings": {
            "title": "Do you offer repairs?",
            "text": "<p>While we don't offer repairs, we're happy to offer advice on how to best repair your mat. </p>"
          }
        }
      },
      "block_order": [
        "text_hNKhHc",

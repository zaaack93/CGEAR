          }
        },
        "1c4f27b0-680f-47a6-bc88-5a7396c4be29": {
          "type": "text",
          "settings": {
            "title": "What forms of payment do you accept?",
            "text": "<p>We accept payments from major credit card companies like Visa, Mastercard, and American Express.</p>"
          }
        }
      },
